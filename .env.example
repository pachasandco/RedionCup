# Copier ce fichier en `.env` et renseigner les clés des services à activer.
# Sans configuration, l'app tourne en mode démo local (adversaires simulés,
# matchs et scores fictifs).

# --- Multijoueur réel (Supabase) ---
# 1. Créer un projet gratuit sur https://supabase.com
# 2. Exécuter supabase/schema.sql dans l'éditeur SQL du projet
# 3. Renseigner l'URL et la clé anon (Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Vrais matchs et scores (football-data.org) ---
# Clé gratuite sur https://www.football-data.org/client/register
VITE_FOOTBALL_DATA_TOKEN=
